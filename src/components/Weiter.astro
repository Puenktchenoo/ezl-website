---
interface Props { links: { href: string; text: string; hell?: boolean }[] }
const { links } = Astro.props;
---
<nav class="weiter" aria-label="Weiterlesen">
  {links.map((l, i) => (
    <a class={`knopf ${i === 0 && !l.hell ? 'knopf--dunkel' : 'knopf--rand-dunkel'}`} href={l.href}>{l.text}</a>
  ))}
</nav>
